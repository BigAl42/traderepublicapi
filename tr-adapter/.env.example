# Copy to .env and fill in. Never commit .env.

# Optional: existing tr_session cookie value (resume without push login)
TR_TOKEN=

# Required for first login or when TR_TOKEN expires
TR_PHONE=+491234567890
TR_PIN=

# Locale for Trade Republic API (de recommended for German timeline exports)
TR_LOCALE=de

# Where web session cookies are stored. Relative paths are resolved against
# TR_ADAPTER_DATA_DIR (default: tr-adapter/ package directory), not process cwd —
# Hermes often respawns MCP with a different working directory.
TR_COOKIES_FILE=tr_cookies.txt

# Optional absolute/relative root for cookies, confirmations, and auth-circuit files.
# TR_ADAPTER_DATA_DIR=/opt/data/home/traderepublicapi/tr-adapter

# Device name shown in the Trade Republic app when confirming login push
# Default: "<hostname> (Hermes MCP)"
# TR_DEVICE_NAME=MacBook Pro (Hermes MCP)

# Optional override for Hermes deployment log path
# TR_ADAPTER_LOG_PATH=/srv/deployments/code-ide/hermes/data/logs/tr_adapter.log

# Enable mutating MCP tools (watchlist add/remove). Default: off.
# TR_MCP_WRITE_ENABLED=1

# Enable real-money trading MCP tools (limit / stop-market / cancel). Default: off.
# There is NO dry-run. Prefer warm session via check_login.py first.
# TR_MCP_TRADING_ENABLED=1

# Allow push-login from MCP read paths when cookies/token resume fails.
# Default: OFF — warmup offline with check_login.py; enable only for first setup.
# TR_MCP_ALLOW_INTERACTIVE_LOGIN=0

# Soft auto-renew on cold/401 sessions from cookies + TR_TOKEN (no push). Default ON.
# TR_MCP_AUTO_RENEW=1
# Auto-recover may start app push when cookies are dead. Default ON.
# TR_MCP_RENEW_ALLOW_PUSH=1

# Auth circuit breaker (persisted next to cookie file as *.auth_circuit.json)
# TR_AUTH_MAX_FAILURES=3
# TR_AUTH_COOLDOWN_SECONDS=900

# Bound confirmation tokens for write tools (TTL seconds; store path optional).
# Relative TR_MCP_CONFIRM_STORE paths also resolve via TR_ADAPTER_DATA_DIR.
# TR_MCP_CONFIRM_TTL_SECONDS=300
# TR_MCP_CONFIRM_STORE=/path/to/confirmations.json

# Minimum spacing between authenticated read subscriptions (seconds). 0 disables.
# TR_MCP_READ_MIN_INTERVAL_SEC=0.15

# After an unverified watchlist write, block further mutations for this many seconds.
# TR_MCP_WRITE_VERIFY_BACKOFF_SEC=60
